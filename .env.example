# Environment variables are read from the process; this file is a reference.
# The server does not automatically load .env files.
HOST=127.0.0.1
PORT=3000
# TERMAI_CWD=/path/to/project
# TERMAI_TOKEN=at-least-24-random-characters-for-remote-access
# TERMAI_ALLOWED_HOSTS=termai.example.com

# TERMAI_BASE_PATH=/t
# History defaults: ~/.bash_history, ~/.bash_eternal_history, and Bash's configured HISTFILE.
# TERMAI_HISTORY_FILE=/path/to/history
# TERMAI_ETERNAL_HISTORY_FILE=/path/to/eternal-history
